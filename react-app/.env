# rosbridge runs in this same container, alongside the dev server, so localhost
# is correct for devcontainer bench testing and real hardware alike.
# .env.local (gitignored) overrides this if you need to point elsewhere.
REACT_APP_ROSBRIDGE_URL=ws://localhost:9090

# Data-path switch, read at build/start time (CRA inlines REACT_APP_* vars).
# false (default): the legacy Socket.js / packets.js WebSocket path, unchanged.
# true: the panels are fed from the roslib hooks in src/hooks/ instead.
# See docs/app-wiring.md.
REACT_APP_USE_ROSBRIDGE=false
