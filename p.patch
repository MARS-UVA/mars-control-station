+  position: static;
+  align-self: flex-start;
 }
+
+/* Right column: the current charts take whatever height is left. */
+.right-panel > .panel {
+  height: 100%;
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+  padding: 10px;
+}
+
+.chart-grid {
+  flex: 1;
+  min-height: 0;
+  height: auto;
+}
+
+.chart-column {
+  flex: 1;
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+}
+
+.chart-fill {
+  flex: 1;
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+}
+
+.chart-fill h3 {
+  margin: 4px 0 2px;
+  font-size: 1rem;
+}
+
+.chart-fill-body {
+  flex: 1;
+  min-height: 90px;
+}
+
+/* Shorter screens (laptops): tighten the fixed-size blocks. */
+@media (max-height: 900px) {
+  /* Rules for elements styled in component CSS files are scoped with
+     .left-panel: those files load after App.css and would otherwise win. */
+  .app-container { padding: 6px 10px; }
+  .gamepad-status { font-size: 1rem; margin: 0; }
+  .left-panel .panel { padding: 8px 12px; }
+  .left-panel .arm-indicator-box { padding: 8px; font-size: 16px; }
+  .command-button-sstop,
+  .command-button-sstop-feedback { font-size: 2rem; }
+  .command-button-digauto,
+  .command-button-dumpauto,
+  .command-button-digauto-feedback,
+  .command-button-dumpauto-feedback,
+  .command-button-dumpauto-front { font-size: 1.2rem; }
+  .timer-overlay { padding: 8px 10px; }
+  .timer-display { font-size: 1.7rem; }
+  .timer-controls { margin-top: 6px; }
+  .timer-button-reset,
+  .timer-button-start,
+  .timer-button-lap { padding: 8px 10px; font-size: 0.95rem; }
+  .chart-space h3 { margin: 2px; font-size: 0.95rem; }
+  .left-panel { gap: 6px; }
+  .rosbridge-status { gap: 2px; }
+  .left-panel .controller-record-buttons { margin-top: 6px; }
+  .left-panel .command-button-record,
+  .left-panel .command-button-run,
+  .left-panel .command-button-reset { padding: 4px 6px; line-height: 1.15; font-size: 0.8rem; }
+  .left-panel .controller-record-buttons { align-items: stretch; }
+  .left-panel .arm-indicator-box { font-size: 15px; }
+  .rosbridge-status-line { font-size: 11px; }
+  .left-panel .arm-indicator-container { gap: 4px; }
+  .left-panel .arm-indicator-box { padding: 6px; }
+  .control-panel .panel-title { font-size: 1rem; margin-bottom: 4px; }
+  .lap-display { margin-bottom: 4px; }
+}
+
