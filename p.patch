+/* ------------------------------------------------------------------------
+   Single-screen layout. The dashboard always fills exactly one screen:
+   three full-height columns, nothing below the fold. The left and right
+   columns share out their height (control buttons and current charts
+   stretch or shrink) and only scroll as a last resort on very short
+   screens. These rules override the older sizes above.
+   ------------------------------------------------------------------------ */
+.app-container {
+  height: 100vh;
+  padding: 10px 12px;
+  overflow: hidden;
 }
 
-.point-cloud-window {
-  position: fixed;
-  right: 16px;
-  bottom: 12px;
-  z-index: 20;
-  width: 520px;
-  height: 380px;
-  min-width: 280px;
-  min-height: 200px;
-  max-width: calc(100vw - 32px);
-  max-height: calc(100vh - 24px);
+.content {
+  flex: 1;
+  min-height: 0;
+  height: auto;
+  gap: 12px;
+}
+
+.left-panel,
+.middle-panel,
+.right-panel {
+  height: 100%;
+  min-height: 0;
+  max-height: none;
+  padding: 2px;
+}
+
+.left-panel {
+  width: 22%;
+  gap: clamp(6px, 1.3vh, 14px);
+  overflow-y: auto;
+}
+
+.middle-panel {
+  width: 50%;
+  justify-content: flex-start;
+  gap: 10px;
+}
+
+.right-panel {
+  width: 28%;
+  overflow-y: auto;
+}
+
+/* Middle column: camera on top, lidar views below. */
+.camera-slot {
+  position: relative;
+  flex: 1.25 1 0;
+  min-height: 0;
+  container-type: size; /* the camera sizes itself to this box (cqw/cqh) */
+}
+
+.camera-slot .esp-not-working {
+  top: auto;
+  bottom: 18px;
+  transform: translateX(-50%);
+  padding: 10px 26px;
+  font-size: 1.25rem;
+  white-space: nowrap;
+  z-index: 15;
+}
+
+.map-row {
+  flex: 1 1 0;
+  min-height: 0;
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 10px;
+}
+
+.map-card {
   display: flex;
   flex-direction: column;
-  resize: both;
+  min-width: 0;
+  min-height: 0;
   overflow: hidden;
   border: 1px solid var(--border-color);
   border-radius: 8px;
   background-color: var(--panel-bg-color);
-  box-shadow: 0 8px 24px var(--box-shadow-color);
+  box-shadow: 0 4px 6px var(--box-shadow-color);
 }
 
-.point-cloud-window-bar {
-  display: flex;
-  align-items: center;
-  justify-content: space-between;
-  padding: 4px 8px 4px 12px;
-  color: var(--primary-color);
+.map-card-title {
+  padding: 4px 10px;
+  font-size: 13px;
   font-weight: 600;
-  cursor: move;
-  user-select: none;
+  color: var(--primary-color);
 }
 
-.point-cloud-window-bar button {
-  padding: 2px 10px;
-  border: 1px solid var(--border-color);
-  border-radius: 4px;
-  background: transparent;
-  color: var(--primary-color);
-  font: inherit;
-  font-weight: 400;
-  cursor: pointer;
+.map-card-body {
+  position: relative;
+  flex: 1;
+  min-height: 0;
+}
+
+/* Left column: the Control Panel buttons take whatever height is left,
+   down to a usable minimum. Everything else keeps its natural height. */
+.left-panel > * {
+  flex-shrink: 0;
+}
+
+.left-panel > .control-panel {
+  flex: 1 1 0;
+  min-height: 110px;
+  display: flex;
+  flex-direction: column;
+}
+
+.control-panel .panel-title {
+  margin: 0 0 6px;
 }
 
-.point-cloud-window-body {
+.control-panel .drive-panel-grid {
   flex: 1;
   min-height: 0;
+  height: auto;
+  gap: 10px;
+  grid-template-rows: minmax(0, 1fr);
+}
+
+.control-panel .drive-panel-stop-col,
+.control-panel .drive-panel-other-col {
+  min-height: 0;
+}
+
+.control-panel .drive-panel-other-col {
+  gap: 10px;
+}
+
+.control-panel .drive-panel-other-col > *,
+.control-panel .drive-panel-stop-col > * {
+  flex: 1 1 0;
+  min-height: 0;
 }
 
-/* Floating minimap (Components/MiniMapWindow.js): same window chrome as the
